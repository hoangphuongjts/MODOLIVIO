{
  "manifest_version": 3,
  "name": "MODOLIVIO Shop Grab",
  "version": "1.0.0",
  "description": "Gửi thông tin sản phẩm đang mở tới MODOLIVIO Local Bridge.",
  "permissions": ["storage", "activeTab"],
  "host_permissions": ["http://127.0.0.1:19740/*", "http://127.0.0.1:19741/*", "http://127.0.0.1:19742/*", "http://127.0.0.1:19743/*", "http://127.0.0.1:19744/*", "http://127.0.0.1:19745/*", "http://127.0.0.1:19746/*", "http://127.0.0.1:19747/*", "http://127.0.0.1:19748/*", "http://127.0.0.1:19749/*"],
  "background": { "service_worker": "service-worker.js" },
  "action": { "default_popup": "popup.html", "default_title": "MODOLIVIO Shop Grab" },
  "content_scripts": [{
    "matches": ["https://*.shopee.vn/*", "https://shopee.vn/*", "https://shop.tiktok.com/*", "https://www.tiktok.com/*"],
    "js": ["shopee_grab.js"], "run_at": "document_idle"
  }]
}
